# Dadinho — variáveis de ambiente (exemplo).
# Copie para .env em dev, ou configure no painel da Vercel (frontend) e no
# /opt/dadinho/.env da VPS (API). Nenhum segredo real deve ser comitado.

# --- Store distribuído (obrigatório em produção) -----------------------------
# Produção hoje: a API roda na VPS (Docker, 4 réplicas) e o estado fica no
# Redis local da própria VPS. Preencha DADINHO_REDIS_URL (e DADINHO_MESSAGE_QUEUE,
# abaixo) — as duas apontam para o MESMO Redis (ex.: redis://redis:6379/0).
DADINHO_REDIS_URL=

# Alternativa: caminho 100% Vercel (serverless), estado no Redis REST da Upstash.
# No deploy atual o Upstash NÃO guarda o estado de jogo (isso é a VPS), mas as
# duas vars continuam obrigatórias na função da Vercel — ela sobe o mesmo app.py
# para servir a página, e sem store configurado o boot com VERCEL=1 falha de
# propósito (Fase 27 I2), em vez de cair em memória e zerar o estado a cada cold
# start (store._selecionar_armazenamento).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Força o modo local (memória em processo). Só para dev/testes.
DADINHO_STORE=

# --- Segredos ---------------------------------------------------------------
# Chave de sessão do Flask. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Ausente = aleatória por processo (ok: a sessão não é usada no jogo).
DADINHO_SECRET_KEY=

# --- Transporte Socket.IO (defaults já são os de produção) -----------------
# async_mode: 'threading' (default; Vercel) ou 'gevent' (VPS, Fase 61). O
# Dockerfile roda gunicorn `gevent`, então a VPS SETA 'gevent' no compose.
DADINHO_ASYNC_MODE=
# WebSocket como padrão na Vercel; '0'/'false' desliga o upgrade (long-polling).
DADINHO_PERMITIR_WEBSOCKET=
# URL da message queue p/ tempo real entre instâncias (Fase 25): no deploy atual
# é o MESMO Redis da VPS (redis://redis:6379/0) — em produção, sem ela os emits
# ficam presos à réplica do handshake. rediss:// do Upstash só no caminho 100%
# Vercel. Vazia = manager local (só dev).
DADINHO_MESSAGE_QUEUE=
# Origens permitidas no /socket.io (Fase 46, VPS separada do frontend):
# lista separada por vírgula ou "*". Vazia = só same-origin (deploy 100% Vercel).
DADINHO_CORS_ORIGINS=
# URL pública da API de socket.io (Fase 46): injetada no <meta> do frontend para
# o io() conectar na VPS. Vazia = mesmo host (regressão zero).
DADINHO_API_URL=

# --- Entropia (provably fair) ----------------------------------------------
# Beacon drand (League of Entropy). Default: https://api.drand.sh (quicknet).
DADINHO_DRAND_URL=
# Cadeia drand usada (default: quicknet). Obs.: a variável no código é
# DADINHO_DRAND_CHAIN (o sufixo _PADRAO é da constante interna).
DADINHO_DRAND_CHAIN=

# --- Tema musical -----------------------------------------------------------
# Congela o tema de 12h numa música específica (seed inteira). Vazio = rotativo.
DADINHO_TEMA_SEED=

# --- Segurança na VPS (Fase 59) ---------------------------------------------
# Limite de sockets simultâneos por IP no /socket.io. '0' (default) = desligado.
# OPT-IN: ativar em picos de abuso. Ao ativar, preferir um valor com folga —
# IPs compartilhados (CGNAT de operadora, rede corporativa) agregam vários
# jogadores legítimos; um limite baixo bloqueia todos eles por até 6h.
DADINHO_LIMITE_SOCKETS_IP=0
# Captcha Cloudflare Turnstile no connect (opt-in). Com ativo, o frontend
# carrega o widget e adia o connect até o token sair. Valores: 1/true.
# Regra de ouro: a API (VPS) valida o token -> precisa de SITEKEY + SECRET;
# o frontend (Vercel) só renderiza o widget -> precisa de ATIVO + SITEKEY.
# Sem sitekey nada liga; sem secret o processo só renderiza (não valida).
DADINHO_CAPTCHA_ATIVO=
# Sitekey pública do Turnstile (injetada no <meta> quando ativo).
DADINHO_TURNSTILE_SITEKEY=
# Secret do Turnstile (siteverify; nunca comitar; só na API/VPS).
TURNSTILE_SECRET=
# Marca ambiente de produção (o guard de CORS e o log de aviso dependem dele;
# a Vercel também usa VERCEL_ENV=production automaticamente). Com produção,
# CORS '*' cai para as origens fixas do frontend (dadinho.memetrigger.com e
# dadinho-hazel.vercel.app) com aviso no log.
DADINHO_ENV=
# Modo CSP: 'bloqueante' aplica a política de verdade (default = Report-Only).
DADINHO_CSP_MODO=